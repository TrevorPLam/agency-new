{
  "name": "@firm/auth",
  "version": "0.0.0",
  "description": "Authentication and authorization package for Firm Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js",
      "require": "./dist/session/index.cjs"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "import": "./dist/permissions/index.js",
      "require": "./dist/permissions/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.3.26",
    "otplib": "^12.0.1",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.30.0",
    "@firm/primitives": "workspace:*",
    "@firm/types": "workspace:*",
    "@firm/db": "workspace:*",
    "@firm/cache": "workspace:*",
    "@firm/crypto": "workspace:*",
    "@firm/errors": "workspace:*",
    "@firm/validators": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@electric-sql/pglite": "^0.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0",
    "oxlint": "^0.7.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
