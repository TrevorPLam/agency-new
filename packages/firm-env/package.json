{
  "name": "@firm/env",
  "version": "0.1.0",
  "description": "Environment variable validation for the Firm platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.3",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/firm/agency.git",
    "directory": "packages/firm-env"
  },
  "keywords": [
    "environment",
    "validation",
    "config",
    "typescript",
    "zod"
  ],
  "author": "Firm Platform Team",
  "license": "UNLICENSED"
}
