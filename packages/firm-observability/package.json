{
  "name": "@firm/observability",
  "version": "1.0.0",
  "description": "Observability and tracing for Firm Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.45.0",
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@firm/types": "workspace:*",
    "@firm/request-context": "workspace:*",
    "@firm/logger": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/instrumentation": "^0.53.0",
    "@opentelemetry/sdk-metrics": "^1.26.0",
    "@opentelemetry/sdk-trace-base": "^1.26.0",
    "@sentry/node": "^8.0.0",
    "pino": "^9.0.0",
    "@types/express": "^4.17.21"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.10.2",
    "eslint": "^10.3.0",
    "typescript": "^5.6.3",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/firm/agency.git",
    "directory": "packages/firm-observability"
  },
  "keywords": [
    "observability",
    "logging",
    "tracing",
    "metrics",
    "opentelemetry",
    "sentry",
    "monitoring",
    "typescript"
  ],
  "author": "Firm Platform Team",
  "license": "UNLICENSED"
}
