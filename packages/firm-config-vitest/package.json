{
  "name": "firm-config-vitest",
  "version": "1.0.0",
  "description": "Shared Vitest configuration factory for the firm platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0",
    "typescript": ">=5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
