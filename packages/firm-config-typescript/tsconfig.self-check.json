{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./src/base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
